# Use ONE or BOTH. Gemini is preferred when both are set (free tier friendly).

# Free: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Paid / usage-based: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional model override
# Gemini default: gemini-2.5-flash
# OpenAI default: gpt-4o-mini
# AI_MODEL=
